diff -ruN a/libgambatte/src/mem/mbc7.cpp b/libgambatte/src/mem/mbc7.cpp
--- a/libgambatte/src/mem/mbc7.cpp
+++ b/libgambatte/src/mem/mbc7.cpp
@@ -0,0 +1,268 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2026 TheGammaSqueeze
+/*
+ * mbc7.cpp - the MBC7 cartridge's accelerometer and serial EEPROM (see mbc7.h).
+ *
+ * Register window (A000-AFFF, register = address bits 4 to 7):
+ *   0  write 0x55: clear the latched reading to 0x8000 and arm the latch
+ *   1  write 0xaa: once armed, copy the sensor's reading into the latch
+ *   2 3  latched X, low then high byte
+ *   4 5  latched Y, low then high byte
+ *   6  0x00, 7  0xff (no third axis)
+ *   8  the EEPROM's pins: bit 7 chip select, bit 6 clock, bit 1 data in, bit 0 data out
+ *   9-F  0xff
+ *
+ * The EEPROM speaks Microwire, a bit on each rising clock while selected: a start bit, a two bit
+ * opcode and eight address bits (the top one unused for 128 words), then:
+ *   10 READ   a 0, then the word, top bit first, and the words after it while the clock runs
+ *   01 WRITE  sixteen data bits, stored once writes are enabled
+ *   11 ERASE  the word becomes 0xffff
+ *   00 with the address's top two bits: 11 enable writes, 00 disable them, 10 erase all,
+ *      01 write all (sixteen data bits for every word)
+ * Programming takes no time here: data out reads 1 (ready) whenever no word is being sent.
+ */
+#include "mbc7.h"
+#include "../savestate.h"
+#include <cstring>
+
+namespace gambatte {
+
+static_assert(sizeof(SaveState::MBC7().data) == Mbc7Chip::state_bytes, "the state blob holds the registers and the EEPROM");
+
+Mbc7Chip::Mbc7Chip()
+: accelX_(accel_level), accelY_(accel_level), active_(false)
+{
+	std::memset(eeprom_, 0xff, sizeof eeprom_);
+	resetRegisters();
+}
+
+void Mbc7Chip::resetRegisters()
+{
+	latchX_ = latchY_ = 0x8000;
+	shift_ = outWord_ = 0;
+	eeState_ = ee_idle;
+	bits_ = addr_ = outBits_ = 0;
+	enable_[0] = enable_[1] = false;
+	armed_ = false;
+	cs_ = clk_ = di_ = false;
+	do_ = true;
+	writeEnable_ = false;
+}
+
+void Mbc7Chip::set(bool active)
+{
+	active_ = active;
+	std::memset(eeprom_, 0xff, sizeof eeprom_);
+	accelX_ = accelY_ = accel_level;
+	resetRegisters();
+}
+
+void Mbc7Chip::setEnable(unsigned which, bool on)
+{
+	enable_[which & 1] = on;
+}
+
+unsigned char Mbc7Chip::read(unsigned p) const
+{
+	if (!enable_[0] || !enable_[1] || p >= 0xb000)
+		return 0xff;
+
+	switch (p >> 4 & 0xf) {
+	case 2: return latchX_ & 0xff;
+	case 3: return latchX_ >> 8;
+	case 4: return latchY_ & 0xff;
+	case 5: return latchY_ >> 8;
+	case 6: return 0x00;
+	case 8: return (cs_ ? 0x80 : 0) | (clk_ ? 0x40 : 0) | (di_ ? 0x02 : 0) | (do_ ? 0x01 : 0);
+	default: return 0xff;
+	}
+}
+
+void Mbc7Chip::write(unsigned p, unsigned data)
+{
+	if (!enable_[0] || !enable_[1] || p >= 0xb000)
+		return;
+
+	switch (p >> 4 & 0xf) {
+	case 0:
+		if (data == 0x55) {
+			latchX_ = latchY_ = 0x8000;
+			armed_ = true;
+		}
+		break;
+	case 1:
+		if (data == 0xaa && armed_) {
+			latchX_ = accelX_;
+			latchY_ = accelY_;
+			armed_ = false;
+		}
+		break;
+	case 8:
+		eepromPins(data);
+		break;
+	}
+}
+
+void Mbc7Chip::eepromPins(unsigned data)
+{
+	bool const cs = data & 0x80, clk = data & 0x40, di = data & 0x02;
+
+	if (!cs) {
+		/* deselected: whatever command was under way ends, a write short of its sixteen bits
+		 * is dropped */
+		eeState_ = ee_idle;
+		do_ = true;
+	} else if (!cs_) {
+		eeState_ = ee_idle;   /* newly selected: the next 1 clocked in is a start bit */
+		bits_ = 0;
+	}
+	if (cs && clk && !clk_)
+		eepromClock(di);
+
+	cs_ = cs;
+	clk_ = clk;
+	di_ = di;
+}
+
+void Mbc7Chip::eepromClock(bool di)
+{
+	switch (eeState_) {
+	case ee_idle:
+		if (di) {
+			eeState_ = ee_command;
+			shift_ = 0;
+			bits_ = 0;
+		}
+		break;
+	case ee_command:
+		shift_ = shift_ << 1 | di;
+		if (++bits_ == 10)
+			eepromCommand();
+		break;
+	case ee_read:
+		do_ = outWord_ >> 15 & 1;
+		outWord_ <<= 1;
+		if (++outBits_ == 16) {
+			/* sequential read: the next word follows with no dummy bit */
+			addr_ = (addr_ + 1) & 0x7f;
+			outWord_ = word(addr_);
+			outBits_ = 0;
+		}
+		break;
+	case ee_write:
+	case ee_write_all:
+		shift_ = shift_ << 1 | di;
+		if (++bits_ == 16) {
+			if (writeEnable_) {
+				if (eeState_ == ee_write)
+					setWord(addr_, shift_);
+				else
+					for (unsigned a = 0; a < eeprom_bytes / 2; ++a)
+						setWord(a, shift_);
+			}
+			eeState_ = ee_done;
+			do_ = true;
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void Mbc7Chip::eepromCommand()
+{
+	unsigned const op = shift_ >> 8 & 3, a = shift_ & 0xff;
+
+	shift_ = 0;
+	bits_ = 0;
+	eeState_ = ee_done;
+	do_ = true;
+	switch (op) {
+	case 2:   /* READ: a dummy 0 first */
+		addr_ = a & 0x7f;
+		outWord_ = word(addr_);
+		outBits_ = 0;
+		do_ = false;
+		eeState_ = ee_read;
+		break;
+	case 1:   /* WRITE */
+		addr_ = a & 0x7f;
+		eeState_ = ee_write;
+		break;
+	case 3:   /* ERASE */
+		if (writeEnable_)
+			setWord(a & 0x7f, 0xffff);
+		break;
+	default:
+		switch (a >> 6 & 3) {
+		case 0: writeEnable_ = false; break;
+		case 1: eeState_ = ee_write_all; break;
+		case 2:
+			if (writeEnable_)
+				std::memset(eeprom_, 0xff, sizeof eeprom_);
+			break;
+		case 3: writeEnable_ = true; break;
+		}
+		break;
+	}
+}
+
+/* the state blob: sixteen bytes of registers, then the EEPROM */
+void Mbc7Chip::saveState(SaveState &state) const
+{
+	unsigned char *const s = state.mbc7.data;
+
+	std::memset(s, 0, 16);
+	s[0] = (enable_[0] ? 0x01 : 0) | (enable_[1] ? 0x02 : 0) | (armed_ ? 0x04 : 0)
+		| (cs_ ? 0x08 : 0) | (clk_ ? 0x10 : 0) | (di_ ? 0x20 : 0) | (do_ ? 0x40 : 0)
+		| (writeEnable_ ? 0x80 : 0);
+	s[1] = eeState_;
+	s[2] = bits_;
+	s[3] = addr_;
+	s[4] = shift_ & 0xff;
+	s[5] = shift_ >> 8;
+	s[6] = outWord_ & 0xff;
+	s[7] = outWord_ >> 8;
+	s[8] = outBits_;
+	s[9] = latchX_ & 0xff;
+	s[10] = latchX_ >> 8;
+	s[11] = latchY_ & 0xff;
+	s[12] = latchY_ >> 8;
+	std::memcpy(s + 16, eeprom_, sizeof eeprom_);
+	state.mbc7.present = active_ ? SaveState::MBC7::full : SaveState::MBC7::absent;
+}
+
+void Mbc7Chip::loadState(SaveState const &state)
+{
+	unsigned char const *const s = state.mbc7.data;
+
+	if (!active_)
+		return;
+	if (state.mbc7.present == SaveState::MBC7::power_on) {
+		/* a reset: the battery keeps the EEPROM */
+		resetRegisters();
+		return;
+	}
+	if (state.mbc7.present != SaveState::MBC7::full)
+		return;   /* a state from before MBC7 support: leave the chip as it is */
+
+	enable_[0] = s[0] & 0x01;
+	enable_[1] = s[0] & 0x02;
+	armed_ = s[0] & 0x04;
+	cs_ = s[0] & 0x08;
+	clk_ = s[0] & 0x10;
+	di_ = s[0] & 0x20;
+	do_ = s[0] & 0x40;
+	writeEnable_ = s[0] & 0x80;
+	eeState_ = s[1] <= ee_done ? s[1] : ee_idle;
+	bits_ = s[2];
+	addr_ = s[3] & 0x7f;
+	shift_ = s[4] | s[5] << 8;
+	outWord_ = s[6] | s[7] << 8;
+	outBits_ = s[8];
+	latchX_ = s[9] | s[10] << 8;
+	latchY_ = s[11] | s[12] << 8;
+	std::memcpy(eeprom_, s + 16, sizeof eeprom_);
+}
+
+}
diff -ruN a/libgambatte/src/mem/mbc7.h b/libgambatte/src/mem/mbc7.h
--- a/libgambatte/src/mem/mbc7.h
+++ b/libgambatte/src/mem/mbc7.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-only
+// Copyright (c) 2026 TheGammaSqueeze
+/*
+ * mbc7.h - what an MBC7 cartridge keeps behind A000-BFFF: a two axis accelerometer and a
+ * 93LC56 serial EEPROM (128 words of 16 bits), the battery save of the tilt carts (Kirby Tilt 'n'
+ * Tumble, Command Master). There is no RAM there: A000-AFFF is a window of registers, picked
+ * by address bits 4 to 7, open only while both enables are set; B000-BFFF reads 0xff.
+ */
+#ifndef GAMBATTE_MBC7_H
+#define GAMBATTE_MBC7_H
+
+namespace gambatte {
+
+struct SaveState;
+
+class Mbc7Chip {
+public:
+	enum { eeprom_bytes = 256, state_bytes = 16 + eeprom_bytes };
+	/* a level sensor reads this on both axes */
+	enum { accel_level = 0x81d0 };
+
+	Mbc7Chip();
+	/* on for an MBC7 cartridge: registers back to power on, the EEPROM erased (the frontend
+	 * then loads the battery save over it); off for any other cartridge */
+	void set(bool active);
+	bool active() const { return active_; }
+
+	/* 0000-1FFF (0x0a) and 4000-5FFF (0x40) each hold one of the two enables */
+	void setEnable(unsigned which, bool on);
+	unsigned char read(unsigned p) const;
+	void write(unsigned p, unsigned data);
+
+	/* the sensor's present reading, which the cartridge copies out when the game latches it */
+	void setAccel(unsigned x, unsigned y) { accelX_ = x & 0xffff; accelY_ = y & 0xffff; }
+
+	unsigned char *eeprom() { return eeprom_; }
+
+	void saveState(SaveState &state) const;
+	void loadState(SaveState const &state);
+
+private:
+	/* where the EEPROM is in a command: waiting for the start bit, taking the opcode and
+	 * address, sending a word out, taking a word in (one address or all), or done */
+	enum { ee_idle, ee_command, ee_read, ee_write, ee_write_all, ee_done };
+
+	unsigned char eeprom_[eeprom_bytes];
+	unsigned short accelX_, accelY_;     /* the sensor now */
+	unsigned short latchX_, latchY_;     /* what the game reads */
+	unsigned short shift_;               /* bits coming in */
+	unsigned short outWord_;             /* bits going out, top bit next */
+	unsigned char eeState_, bits_, addr_, outBits_;
+	bool active_, enable_[2], armed_;
+	bool cs_, clk_, di_, do_, writeEnable_;
+
+	void resetRegisters();
+	unsigned word(unsigned a) const { return eeprom_[2 * a] | eeprom_[2 * a + 1] << 8; }
+	void setWord(unsigned a, unsigned v) { eeprom_[2 * a] = v & 0xff; eeprom_[2 * a + 1] = v >> 8 & 0xff; }
+	void eepromPins(unsigned data);
+	void eepromClock(bool di);
+	void eepromCommand();
+};
+
+}
